# ---- Database ----
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Messaging (local: LocalStack; prod: AWS SQS) ----
SQS_ENDPOINT_URL=http://localhost:4566
SQS_RESEARCH_QUEUE_URL=http://localhost:4566/000000000000/research-requested
AWS_REGION=us-east-1

# ---- LLM providers ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Data providers ----
# synthetic (default, offline) or live (Yahoo Finance + SEC EDGAR)
DATA_PROVIDER=synthetic
# Required by SEC EDGAR for live filings; must include contact email.
SEC_USER_AGENT=M Capital research@example.com

# ---- Observability ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis-agent-worker
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aegis-capital

# ---- Auth ----
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
