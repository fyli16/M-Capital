# Agent-worker configuration example.
# Copy to `.env` and fill in real values:  cp .env.example .env
# Every setting has a safe default (fake LLM + synthetic data), so the worker
# runs fully offline with no file at all. Override here to go "genuine".

# ---- LLM ----------------------------------------------------------------
# fake   = deterministic offline outputs (no API key, default)
# openai = real OpenAI calls (requires OPENAI_API_KEY and `pip install .[openai]`)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-real-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_TEMPERATURE=0.2

# ---- Data providers -----------------------------------------------------
# synthetic = deterministic offline data (default)
# live      = Yahoo Finance + SEC EDGAR (requires `pip install .[live]`;
#             falls back to synthetic on any feed error)
DATA_PROVIDER=synthetic
# Required for live SEC EDGAR filings: 'Name Company email@example.com'
SEC_USER_AGENT=

# ---- Persistence / infra ------------------------------------------------
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# ---- Messaging (SQS) ----------------------------------------------------
SQS_ENDPOINT_URL=
SQS_RESEARCH_QUEUE_URL=
AWS_REGION=us-east-1
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_TIMEOUT=300

# ---- Observability (OpenTelemetry) --------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aegis-agent-worker
METRICS_EXPORT_INTERVAL_MS=15000

# ---- LangSmith tracing --------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aegis-capital

# ---- Debate tuning ------------------------------------------------------
CONFLICT_THRESHOLD=0.35
CONVERGE_THRESHOLD=0.15
DEBATE_DAMPING=0.30
DEFAULT_MAX_ROUNDS=3

# ---- Resilience ---------------------------------------------------------
AGENT_TIMEOUT_SECONDS=60.0
TOOL_CACHE_TTL_SECONDS=900
